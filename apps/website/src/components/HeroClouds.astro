---
// Same silhouette as apps/pwa/src/components/sky/clouds.tsx
const CLOUD_PATH =
  "M46 96 C24 96 10 82 14 66 C2 54 12 34 32 34 C36 16 62 6 80 18 C92 2 124 2 136 18 C156 8 180 18 182 38 C200 42 208 62 196 76 C204 90 190 100 172 96 Z";

const clouds = [
  { className: "cloud-1" },
  { className: "cloud-2" },
  { className: "cloud-3" },
];
---

{
  clouds.map((cloud, i) => (
    <div class={`hero-cloud ${cloud.className}`}>
      <svg viewBox="0 0 212 104" width="100%" height="100%" aria-hidden="true">
        <defs>
          <linearGradient id={`hero-cloud-${i}-body`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="var(--cloud-tint)"></stop>
            <stop offset="62%" stop-color="var(--cloud-tint)"></stop>
            <stop offset="100%" stop-color="var(--cloud-shade)"></stop>
          </linearGradient>
          <filter id={`hero-cloud-${i}-soft`} x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur stdDeviation="7"></feGaussianBlur>
          </filter>
          <clipPath id={`hero-cloud-${i}-clip`}>
            <path d={CLOUD_PATH}></path>
          </clipPath>
        </defs>
        <path d={CLOUD_PATH} fill={`url(#hero-cloud-${i}-body)`}></path>
        <g clip-path={`url(#hero-cloud-${i}-clip)`}>
          <ellipse
            cx="92"
            cy="26"
            rx="74"
            ry="26"
            fill="rgba(255,255,255,0.85)"
            filter={`url(#hero-cloud-${i}-soft)`}></ellipse>
        </g>
      </svg>
    </div>
  ))
}
