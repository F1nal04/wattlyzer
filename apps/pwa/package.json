{
  "name": "@wattlyzer/pwa",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "TZ=UTC bun test src",
    "test:watch": "TZ=UTC bun test --watch src",
    "verify-seo": "TZ=UTC bun test seo.dist.test.ts"
  },
  "dependencies": {
    "@wattlyzer/api-client": "workspace:*",
    "@wattlyzer/core": "workspace:*",
    "@wattlyzer/i18n": "workspace:*",
    "@wattlyzer/legal": "workspace:*",
    "@wattlyzer/theme": "workspace:*",
    "@tanstack/query-sync-storage-persister": "^5.90.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-query-persist-client": "^5.90.0",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-start": "^1.132.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@netlify/vite-plugin-tanstack-start": "^1.3.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "vite": "^7.1.0"
  },
  "nx": {
    "name": "pwa",
    "tags": [
      "type:app",
      "scope:pwa",
      "platform:web"
    ],
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/.netlify"
        ]
      },
      "verify-seo": {
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
