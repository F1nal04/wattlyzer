{
  "name": "@wattlyzer/pwa",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "TZ=UTC bun test src",
    "test:watch": "TZ=UTC bun test --watch src",
    "verify-seo": "TZ=UTC bun test seo.dist.test.ts"
  },
  "dependencies": {
    "@wattlyzer/api-client": "workspace:*",
    "@wattlyzer/core": "workspace:*",
    "@wattlyzer/i18n": "workspace:*",
    "@wattlyzer/legal": "workspace:*",
    "@wattlyzer/theme": "workspace:*",
    "@tanstack/query-sync-storage-persister": "^5.103.2",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-query-persist-client": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-start": "^1.168.58",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@netlify/vite-plugin-tanstack-start": "^1.3.19",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6",
    "babel-plugin-react-compiler": "^1.0.0",
    "vite": "^8"
  },
  "nx": {
    "name": "pwa",
    "tags": ["type:app", "scope:pwa", "platform:web"],
    "targets": {
      "build": {
        "outputs": ["{projectRoot}/dist", "{projectRoot}/.netlify"]
      },
      "verify-seo": {
        "dependsOn": ["build"]
      }
    }
  }
}
