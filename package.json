{
  "name": "wattlyzer",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "nx run-many -t dev --projects=pwa,website --parallel=2",
    "dev:pwa": "nx dev pwa",
    "dev:website": "nx dev website",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:run": "nx run-many -t test",
    "check": "nx run-many -t lint,typecheck,test,build,verify-seo",
    "affected": "nx affected -t lint,typecheck,test,build,verify-seo"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nx/devkit": "latest",
    "@nx/eslint-plugin": "latest",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.5.0",
    "eslint": "^9.39.0",
    "eslint-plugin-astro": "latest",
    "nx": "latest",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
