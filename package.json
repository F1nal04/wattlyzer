{
  "name": "wattlyzer",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.23.4",
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "nx run-many -t dev --projects=pwa,website --parallel=2",
    "dev:pwa": "nx dev pwa",
    "dev:website": "nx dev website",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "check": "nx run-many -t lint,typecheck,test,build,verify-seo",
    "affected": "nx affected -t lint,typecheck,test,build,verify-seo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/devkit": "^24.0.1",
    "@nx/eslint-plugin": "^24.0.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "latest",
    "nx": "^24.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
